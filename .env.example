# ==============================================================================
# Nexus Multi-Vendor E-Commerce Platform - Root Environment Variables Template
# Copy this file to .env and configure with your specific environment keys
# ==============================================================================

# Node Environment & Network
NODE_ENV=development
PORT=3000

# Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
ADMIN_CLIENT_URL=http://localhost:4200

# Neon PostgreSQL Database Connection (Prisma ORM)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&uselibpqcompat=true"
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require&uselibpqcompat=true"
DB_POOL_MAX=20

# JWT Authentication Secrets (Native Multi-Tenant RBAC)
JWT_SECRET="your-32-character-ultra-secure-jwt-secret-key-here"
JWT_REFRESH_SECRET="your-32-character-ultra-secure-refresh-token-secret-here"

# Redis & BullMQ Queue Configuration (Upstash / Local)
REDIS_URL="rediss://default:token@sample.upstash.io:6379"
UPSTASH_REDIS_REST_URL="https://sample.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token_here"

# Resend Transactional Email Engine
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM_EMAIL="Nexus Marketplace <orders@yourdomain.com>"
SMTP_URL="smtp://localhost:1025"

# Cloudflare R2 / S3 Object Storage
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="nexus-marketplace-assets"
R2_PUBLIC_URL="https://media.yourdomain.com"

# Stripe Connect & Webhooks (Escrow & Settlement)
STRIPE_SECRET_KEY="sk_test_your_stripe_test_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_signing_secret"
CRON_SECRET="your_cron_schedule_auth_secret_key"

# Optional Sentry Telemetry
SENTRY_DSN=""
