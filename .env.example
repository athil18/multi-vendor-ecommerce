# ==============================================================================
# Nexus Multi-Vendor E-Commerce Platform - Root Environment Variables Template
# Copy this file to .env and configure for your local environment
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
ADMIN_CLIENT_URL=http://localhost:4200

# PostgreSQL Database Connection (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marketplace?schema=public"
DB_POOL_MAX=20

# JWT Authentication Secrets (Generate secure random 32+ char strings in production)
JWT_SECRET="your-32-character-ultra-secure-jwt-secret-key-here"
JWT_REFRESH_SECRET="your-32-character-ultra-secure-refresh-token-secret-here"

# Redis & BullMQ Queue Configuration
REDIS_URL="redis://localhost:6379"

# Stripe Connect & Webhooks (Test Mode)
STRIPE_SECRET_KEY="sk_test_your_stripe_test_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_signing_secret"
CRON_SECRET="your_cron_schedule_auth_secret_key"

# SMTP Email Configuration
SMTP_URL="smtp://localhost:1025"

# Optional Sentry Telemetry
SENTRY_DSN=""
