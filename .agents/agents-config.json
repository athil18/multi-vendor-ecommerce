{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Nexus Multi-Vendor E-Commerce AI Agent Hub",
  "version": "2.0.0",
  "description": "Configuration linking Agency AI Specialists and custom skill sets to Nexus Marketplace components.",
  "agencyRoot": "e:/500+_AI_Agent/agency-agents",
  "projectRoot": "e:/500+_AI_Agent/multi-vendor-ecommerce",
  "designSkill": "e:/500+_AI_Agent/.agents/skills/ecommerce_design_directorate",
  "teamMappings": [
    {
      "division": "engineering",
      "targetComponents": [
        "apps/src/app/api",
        "apps/src/lib",
        "apps/src/models",
        "apps/src/repositories"
      ],
      "primaryAgents": [
        "engineering-architect",
        "engineering-backend-developer",
        "engineering-frontend-developer",
        "engineering-database-administrator",
        "engineering-devops-engineer"
      ],
      "responsibilities": [
        "Next.js App Router API design",
        "PostgreSQL 16 / Prisma ORM schema optimization & indexing",
        "TypeScript type definitions & interfaces",
        "Prisma connection pooling and atomic ACID transactions"
      ]
    },
    {
      "division": "security",
      "targetComponents": [
        "apps/src/lib/auth.ts",
        "apps/src/lib/jwt.ts",
        "apps/src/middleware.ts",
        "apps/src/app/api/auth"
      ],
      "primaryAgents": [
        "security-appsec-engineer",
        "security-compliance-auditor",
        "security-secrets-credential-engineer",
        "security-cloud-security-architect"
      ],
      "responsibilities": [
        "JWT token validation & refresh rotation",
        "Role-Based Access Control (RBAC) enforcement",
        "OWASP Top 10 vulnerability remediation",
        "Webhook signature verification and idempotency"
      ]
    },
    {
      "division": "design",
      "targetComponents": [
        "apps/src/components",
        "apps/src/app/globals.css",
        "apps/src/app/page.tsx",
        "apps/src/app/products",
        "apps/src/app/stores",
        "angular-frontend/src/app/features",
        "angular-frontend/src/app/shared/components"
      ],
      "primaryAgents": [
        "design-ui-designer",
        "design-ux-architect",
        "design-brand-guardian",
        "design-whimsy-injector",
        "design-ui-finish-gate-reviewer",
        "testing-accessibility-auditor",
        "testing-performance-benchmarker"
      ],
      "responsibilities": [
        "Tailwind v4 brand tokens (--color-brand-50..950) & luxury glassmorphism enforcement",
        "Micro-animations & zero-JS GPU-accelerated CSS keyframe transitions",
        "Responsive multi-viewport ergonomics (Mobile 375px, Tablet 768px, Desktop 1366px)",
        "WCAG 2.1 AA contrast and accessible name synchronization (SC 2.5.3)",
        "Anti-generic UI gate and consumer trust value messaging",
        "Lighthouse performance preservation (0ms TBT, 0.00 CLS, <1.8s LCP)"
      ]
    },
    {
      "division": "finance",
      "targetComponents": [
        "apps/src/app/api/checkout",
        "apps/src/app/api/webhooks",
        "apps/src/lib/stripe.ts",
        "apps/src/lib/ledger.ts"
      ],
      "primaryAgents": [
        "finance-payment-specialist",
        "specialized-accounts-payable-agent"
      ],
      "responsibilities": [
        "Stripe Connect custom payout routing",
        "Multi-seller split calculations & platform fee accounting",
        "Double-entry ledger transaction tracking (debit === credit)",
        "Atomic refund & dispute resolution"
      ]
    },
    {
      "division": "testing",
      "targetComponents": [
        "apps/src/components/ui/__tests__",
        "apps/test",
        "apps/vitest.config.ts"
      ],
      "primaryAgents": [
        "testing-test-automation-engineer",
        "testing-performance-benchmarker",
        "testing-evidence-collector",
        "testing-reality-checker"
      ],
      "responsibilities": [
        "Vitest unit & component test coverage",
        "Playwright end-to-end checkout & auth flow validation",
        "Load testing and race-condition stock decrement verification"
      ]
    },
    {
      "division": "support",
      "targetComponents": [
        "apps/src/app/admin",
        "apps/docs"
      ],
      "primaryAgents": [
        "support-legal-compliance-checker",
        "support-infrastructure-maintainer",
        "support-executive-summary-generator"
      ],
      "responsibilities": [
        "Seller terms of service & KYC compliance",
        "Admin product moderation queue workflows",
        "Comprehensive documentation maintenance"
      ]
    }
  ]
}
