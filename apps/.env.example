# Localhost Development Environment Variables Example
# Duplicate this file to .env for local development

# Database Configuration (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marketplace?schema=public"
DB_POOL_MAX=20

# JWT Authentication Secrets (Replace with random strings for production)
JWT_SECRET="nexus-ecommerce-local-dev-jwt-secret-key-32-chars-min"
JWT_REFRESH_SECRET="nexus-ecommerce-local-dev-refresh-secret-key-32-chars-min"

# Application URLs & Ports
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CLIENT_URL="http://localhost:3000"
ADMIN_CLIENT_URL="http://localhost:4200"

# Redis & Background Queue (BullMQ)
REDIS_URL="redis://localhost:6379"

# Stripe Connect Payments (Test Mode)
STRIPE_SECRET_KEY="sk_test_replace_with_test_stripe_secret"
STRIPE_WEBHOOK_SECRET="whsec_replace_with_test_webhook_secret"
CRON_SECRET="cron_local_development_secret_key"

# Email / SMTP Transport (Local Mailhog or Ethereal)
SMTP_URL="smtp://localhost:1025"

# Sentry Telemetry (Optional for local dev)
SENTRY_DSN=""
