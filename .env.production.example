# ==============================================================================
# Open-Source Self-Hosted Production Environment Variables Template
# Copy this file to .env.production on your server
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# Public Domain (e.g., https://nexus.yourdomain.com)
DOMAIN=nexus.yourdomain.com
NEXT_PUBLIC_APP_URL=https://nexus.yourdomain.com
CLIENT_URL=https://nexus.yourdomain.com

# PostgreSQL Credentials (Matched with docker-compose.prod.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_a_secure_postgres_password
POSTGRES_DB=marketplace
DATABASE_URL="postgresql://postgres:generate_a_secure_postgres_password@postgres:5432/marketplace?schema=public"
DB_POOL_MAX=20

# Redis Credentials (Matched with docker-compose.prod.yml)
REDIS_PASSWORD=generate_a_secure_redis_password
REDIS_URL="redis://:generate_a_secure_redis_password@redis:6379"

# JWT Authentication Secrets (Generate with: openssl rand -base64 32)
JWT_SECRET=your_32_char_random_jwt_secret_key_here
JWT_REFRESH_SECRET=your_32_char_random_refresh_secret_key_here

# Stripe Connect & Webhook Credentials
STRIPE_SECRET_KEY=sk_live_your_live_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_live_webhook_secret_key
CRON_SECRET=your_random_cron_auth_secret_key

# Transactional Email (SMTP or open-source Mailpit / Postal / Resend)
SMTP_URL="smtp://smtp_user:smtp_password@smtp.yourprovider.com:587"

# Sentry Telemetry (Optional)
SENTRY_DSN=""
