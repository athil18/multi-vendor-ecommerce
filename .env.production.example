# ==============================================================================
# Open-Source Self-Hosted Production Environment Variables Template
# Copy this file to .env.production on your server
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# Public Domain (e.g., https://nexus.yourdomain.com)
DOMAIN=nexus.yourdomain.com
NEXT_PUBLIC_APP_URL=https://nexus.yourdomain.com
CLIENT_URL=https://nexus.yourdomain.com
ADMIN_CLIENT_URL=https://admin.yourdomain.com

# Database Connection (Neon or Self-Hosted PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-production-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&uselibpqcompat=true"
DIRECT_URL="postgresql://user:password@ep-production.us-east-2.aws.neon.tech/neondb?sslmode=require&uselibpqcompat=true"
DB_POOL_MAX=25

# Redis Configuration (Upstash or Containerized Redis)
REDIS_URL="rediss://default:token@sample.upstash.io:6379"
UPSTASH_REDIS_REST_URL="https://sample.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token_here"

# JWT Authentication Secrets (Generate with: openssl rand -base64 32)
JWT_SECRET=your_32_char_random_jwt_secret_key_here
JWT_REFRESH_SECRET=your_32_char_random_refresh_secret_key_here

# Resend Transactional Email Engine
RESEND_API_KEY="re_live_your_resend_api_key_here"
RESEND_FROM_EMAIL="Nexus Orders <orders@yourdomain.com>"
SMTP_URL=""

# Cloudflare R2 Object Storage (Zero-Egress Fees)
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="nexus-marketplace-assets"
R2_PUBLIC_URL="https://media.yourdomain.com"

# Stripe Connect & Webhook Credentials (Live Mode)
STRIPE_SECRET_KEY=sk_live_your_live_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_live_webhook_secret_key
CRON_SECRET=your_random_cron_auth_secret_key

# Sentry Telemetry (Optional)
SENTRY_DSN=""
