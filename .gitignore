# ==============================================================================
# Nexus Multi-Vendor E-Commerce Platform - Git Ignore Rules
# ==============================================================================

# Environment & Sensitive Credentials (CRITICAL)
.env
.env*.local
.env.development
.env.test
.env.production
.env.staging
*.env
*.pem
*.key
*.cert
*.pfx
*.p12

# Allow environment example template
!.env.example

# Internal documents & metadata
.agents/
**/.agents/
.ai/
**/.ai/
*.pdf
**/*.pdf

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Next.js Build Outputs & Cache
.next/
**/.next/
out/
build/
dist/
.vercel

# User Uploads
public/uploads/*
!public/uploads/.gitkeep

# Logs & Runtime State
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.dev-state.json

# TypeScript & Cache
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts

# Testing & Coverage
coverage/
**/coverage/
test-results/
playwright-report/
blob-report/

# OS & Editor Metadata
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
